@article{corbettaPETStudyVisuospatial1993,
  title = {A {{PET}} Study of Visuospatial Attention},
  author = {Corbetta, M. and Miezin, F. M. and Shulman, G. L. and Petersen, S. E.},
  year = {1993},
  month = mar,
  journal = {Journal of Neuroscience},
