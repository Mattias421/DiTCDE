@misc{liYourDiffusionModel2023,
  title = {Your {{Diffusion Model}} Is {{Secretly}} a {{Zero-Shot Classifier}}},
  author = {Li, Alexander C. and Prabhudesai, Mihir and Duggal, Shivam and Brown, Ellis and Pathak, Deepak},
  year = {2023},
