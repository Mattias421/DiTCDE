}

@misc{campbellTransDimensionalGenerativeModeling2023,
  title = {Trans-{{Dimensional Generative Modeling}} via {{Jump Diffusion Models}}},
  author = {Campbell, Andrew and Harvey, William and Weilbach, Christian and De Bortoli, Valentin and Rainforth, Tom and Doucet, Arnaud},
  year = {2023},
