  issn = {2379-190X},
  keywords = {audio databases,Audio event detection,Birds,data collection,Labeling,Music,Ontologies,sound ontology,Taxonomy},
  month = {March},
  pages = {776--780},
  shorttitle = {Audio {{Set}}},
