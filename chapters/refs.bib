@misc{batzolisVariationalDiffusionAutoencoder2023,
  abstract = {As a widely recognized approach to deep generative modeling, Variational Auto-Encoders (VAEs) still face challenges with the quality of generated images, often presenting noticeable blurriness. This issue stems from the unrealistic assumption that approximates the conditional data distribution, \$p({\textbackslash}textbf\{x\} {\textbar} {\textbackslash}textbf\{z\})\$, as an isotropic Gaussian. In this paper, we propose a novel solution to address these issues. We illustrate how one can extract a latent space from a pre-existing diffusion model by optimizing an encoder to maximize the marginal data log-likelihood. Furthermore, we demonstrate that a decoder can be analytically derived post encoder-training, employing the Bayes rule for scores. This leads to a VAE-esque deep latent variable model, which discards the need for Gaussian assumptions on \$p({\textbackslash}textbf\{x\} {\textbar} {\textbackslash}textbf\{z\})\$ or the training of a separate decoder network. Our method, which capitalizes on the strengths of pre-trained diffusion models and equips them with latent spaces, results in a significant enhancement to the performance of VAEs.},
  archiveprefix = {arxiv},
  author = {Batzolis, Georgios and Stanczuk, Jan and Sch{\"o}nlieb, Carola-Bibiane},
  doi = {10.48550/arXiv.2304.12141},
  eprint = {2304.12141},
  file = {/home/mattias/snap/zotero-snap/common/Zotero/storage/ZLXNJ85D/Batzolis et al_2023_Variational Diffusion Auto-encoder.pdf;/home/mattias/snap/zotero-snap/common/Zotero/storage/8IYY4W4A/2304.html},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Computer Science - Machine Learning,Statistics - Machine Learning},
  month = {May},
  number = {arXiv:2304.12141},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  shorttitle = {Variational {{Diffusion Auto-encoder}}},
  title = {Variational {{Diffusion Auto-encoder}}: {{Latent Space Extraction}} from {{Pre-trained Diffusion Models}}},
  urldate = {2024-01-23},
  year = {2023}
}

