@misc{mccannOptimalTransportationUnequal2019,
  abstract = {We establish that solving an optimal transportation problem in which the source and target densities are defined on manifolds with different dimensions, is equivalent to solving a new nonlocal analog of the Monge-Amp{\textbackslash}`ere equation, introduced here for the first time. Under suitable topological conditions, we also establish that solutions are smooth if and only if a local variant of the same equation admits a smooth and uniformly elliptic solution. We show that this local equation is elliptic, and \$C{\textasciicircum}\{2,{\textbackslash}alpha\}\$ solutions can therefore be bootstrapped to obtain higher regularity results, assuming smoothness of the corresponding differential operator, which we prove under simplifying assumptions. For one-dimensional targets, our sufficient criteria for regularity of solutions to the resulting ODE are considerably less restrictive than those required by earlier works.},
  archiveprefix = {arxiv},
  author = {McCann, Robert J. and Pass, Brendan},
  doi = {10.48550/arXiv.1805.11187},
  eprint = {1805.11187},
  file = {/home/mattias/snap/zotero-snap/common/Zotero/storage/RMCQHI5W/McCann_Pass_2019_Optimal transportation between unequal dimensions.pdf;/home/mattias/snap/zotero-snap/common/Zotero/storage/2JVM8AK9/1805.html},
