}

@misc{chenMaestroULeveragingJoint2022,
  title = {Maestro-{{U}}: {{Leveraging}} Joint Speech-Text Representation Learning for Zero Supervised Speech {{ASR}}},
  shorttitle = {Maestro-{{U}}},
  author = {Chen, Zhehuai and Bapna, Ankur and Rosenberg, Andrew and Zhang, Yu and Ramabhadran, Bhuvana and Moreno, Pedro and Chen, Nanxin},
  year = {2022},
