  issn = {2640-3498},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  langid = {english},
  month = {August},
  pages = {1792--1802},
  primaryclass = {cs, stat},
  publisher = {PMLR},
  title = {Conditional Simulation Using Diffusion {{Schr{\"o}dinger}} Bridges},
  urldate = {2023-05-16},
