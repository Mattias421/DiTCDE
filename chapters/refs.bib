@article{chetriteSchrOdinger19312021,
  title = {E. {{Schr}}{\textbackslash}"odinger's 1931 Paper "{{On}} the {{Reversal}} of the {{Laws}} of {{Nature}}" ["{\textbackslash}"{{Uber}} Die {{Umkehrung}} Der {{Naturgesetze}}",{{Sitzungsberichte}} Der Preussischen {{Akademie}} Der {{Wissenschaften}}, Physikalische Mathematische {{Klasse}}, 8 {{N9}} 144-153]},
