@misc{baiDeepEquilibriumModels2019,
  title = {Deep {{Equilibrium Models}}},
  author = {Bai, Shaojie and Kolter, J. Zico and Koltun, Vladlen},
  year = {2019},
  month = oct,
  number = {arXiv:1909.01377},
  eprint = {1909.01377},
  primaryclass = {cs, stat},
