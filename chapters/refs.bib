  abstract = {Diffusion models have become competitive candidates for solving various inverse problems. Models trained for specific inverse problems work well but are limited to their particular use cases, whereas methods that use problem-agnostic models are general but often perform worse empirically. To address this dilemma, we introduce Pseudoinverse-guided Diffusion Models (\${\textbackslash}Pi\$GDM), an approach that uses problem-agnostic models to close the gap in performance. \${\textbackslash}Pi\$GDM directly estimates conditional scores from the measurement model of the inverse problem without additional training. It can address inverse problems with noisy, non-linear, or even non-differentiable measurements, in contrast to many existing approaches that are limited to noiseless linear ones. We illustrate the empirical effectiveness of \${\textbackslash}Pi\$GDM on several image restoration tasks, including super-resolution, inpainting and JPEG restoration. On ImageNet, \${\textbackslash}Pi\$GDM is competitive with state-of-the-art diffusion models trained on specific tasks, and is the first to achieve this with problem-agnostic diffusion models. \${\textbackslash}Pi\$GDM can also solve a wider set of inverse problems where the measurement processes are composed of several simpler ones.},
  langid = {english},
  file = {/home/mattias/snap/zotero-snap/common/Zotero/storage/GLKNF7Q6/Song et al_2023_Pseudoinverse-Guided Diffusion Models for Inverse Problems.pdf}
