@misc{guOptimalTransportGuidedConditional2023,
  title = {Optimal {{Transport-Guided Conditional Score-Based Diffusion Models}}},
  author = {Gu, Xiang and Yang, Liwei and Sun, Jian and Xu, Zongben},
