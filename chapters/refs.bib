@misc{wangDiffusionbasedSpeechEnhancement2024,
    title = {Diffusion-based {Speech} {Enhancement} with {Schrödinger} {Bridge} and {Symmetric} {Noise} {Schedule}},
    url = {http://arxiv.org/abs/2409.05116},
    doi = {10.48550/arXiv.2409.05116},
    abstract = {Recently, diffusion-based generative models have demonstrated remarkable performance in speech enhancement tasks. However, these methods still encounter challenges, including the lack of structural information and poor performance in low Signal-to-Noise Ratio (SNR) scenarios. To overcome these challenges, we propose the Schr{\textbackslash}"oodinger Bridge-based Speech Enhancement (SBSE) method, which learns the diffusion processes directly between the noisy input and the clean distribution, unlike conventional diffusion-based speech enhancement systems that learn data to Gaussian distributions. To enhance performance in extremely noisy conditions, we introduce a two-stage system incorporating ratio mask information into the diffusion-based generative model. Our experimental results show that our proposed SBSE method outperforms all the baseline models and achieves state-of-the-art performance, especially in low SNR conditions. Importantly, only a few inference steps are required to achieve the best result.},
    urldate = {2025-01-29},
    publisher = {arXiv},
    author = {Wang, Siyi and Liu, Siyi and Harper, Andrew and Kendrick, Paul and Salzmann, Mathieu and Cernak, Milos},
    month = sep,
    year = {2024},
    note = {arXiv:2409.05116 [eess]},
    keywords = {Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing},
}
