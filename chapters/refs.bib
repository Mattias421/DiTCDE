@article{haeb-umbachSpeechProcessingDigital2019,
  abstract = {Once a popular theme of futuristic science fiction or far-fetched technology forecasts, digital home assistants with a spoken language interface have become a ubiquitous commodity today. This success has been made possible by major advancements in signal processing and machine learning for so-called far-field speech recognition, where the commands are spoken at a distance from the sound-capturing device. The challenges encountered are quite unique and different from many other use cases of automatic speech recognition (ASR). The purpose of this article is to describe, in a way that is amenable to the nonspecialist, the key speech processing algorithms that enable reliable, fully hands-free speech interaction with digital home assistants. These technologies include multichannel acoustic echo cancellation (MAEC), microphone array processing and dereverberation techniques for signal enhancement, reliable wake-up word and end-of-interaction detection, and high-quality speech synthesis as well as sophisticated statistical models for speech and language, learned from large amounts of heterogeneous training data. In all of these fields, deep learning (DL) has played a critical role.},
  author = {{Haeb-Umbach}, Reinhold and Watanabe, Shinji and Nakatani, Tomohiro and Bacchiani, Michiel and Hoffmeister, Bjorn and Seltzer, Michael L. and Zen, Heiga and Souden, Mehrez},
  doi = {10.1109/MSP.2019.2918706},
  file = {/home/mattias/snap/zotero-snap/common/Zotero/storage/64S6IQ6V/Haeb-Umbach et al_2019_Speech Processing for Digital Home Assistants.pdf;/home/mattias/snap/zotero-snap/common/Zotero/storage/CCLXSJD7/8887564.html},
  issn = {1558-0792},
  journal = {IEEE Signal Processing Magazine},
  keywords = {Journal club feb,Loudspeakers,Microphones,Reverberation,Speech processing,Speech recognition},
  month = {November},
  number = {6},
  pages = {111--124},
  shorttitle = {Speech {{Processing}} for {{Digital Home Assistants}}},
  title = {Speech {{Processing}} for {{Digital Home Assistants}}: {{Combining Signal Processing With Deep-Learning Techniques}}},
  volume = {36},
  year = {2019}
}

@misc{hamdoucheGenerativeModelingTime2023,
  abstract = {We propose a novel generative model for time series based on Schr\{{\textbackslash}"o\}dinger bridge (SB) approach. This consists in the entropic interpolation via optimal transport between a reference probability measure on path space and a target measure consistent with the joint data distribution of the time series. The solution is characterized by a stochastic differential equation on finite horizon with a path-dependent drift function, hence respecting the temporal dynamics of the time series distribution. We can estimate the drift function from data samples either by kernel regression methods or with LSTM neural networks, and the simulation of the SB diffusion yields new synthetic data samples of the time series. The performance of our generative model is evaluated through a series of numerical experiments. First, we test with a toy autoregressive model, a GARCH Model, and the example of fractional Brownian motion, and measure the accuracy of our algorithm with marginal and temporal dependencies metrics. Next, we use our SB generated synthetic samples for the application to deep hedging on real-data sets. Finally, we illustrate the SB approach for generating sequence of images.},
  archiveprefix = {arxiv},
  author = {Hamdouche, Mohamed and {Henry-Labordere}, Pierre and Pham, Huy{\^e}n},
  doi = {10.48550/arXiv.2304.05093},
  eprint = {2304.05093},
  file = {/home/mattias/snap/zotero-snap/common/Zotero/storage/JSW9IXZB/Hamdouche et al_2023_Generative modeling for time series via Schr -o dinger bridge.pdf;/home/mattias/snap/zotero-snap/common/Zotero/storage/5H4BD5AU/2304.html},
  keywords = {Mathematics - Optimization and Control,Mathematics - Probability,Quantitative Finance - Computational Finance,Statistics - Machine Learning},
  month = {April},
  number = {arXiv:2304.05093},
  primaryclass = {math, q-fin, stat},
  publisher = {arXiv},
  title = {Generative Modeling for Time Series via {{Schr}}\{{\textbackslash}"o\}dinger Bridge},
  urldate = {2023-05-17},
  year = {2023}
}

