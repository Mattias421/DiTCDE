@article{chetriteSchrOdinger19312021,
  abstract = {We present an English translation of Erwin Schr{\textbackslash}"odinger's paper on "On the Reversal of the Laws of Nature". In this paper Schr{\textbackslash}"odinger analyses the idea of time reversal of a diffusion process. Schr{\textbackslash}"odinger's paper acted as a prominent source of inspiration for the works of Bernstein on reciprocal processes and of Kolmogorov on time reversal properties of Markov processes and detailed balance. The ideas outlined by Schr{\textbackslash}"odinger also inspired the development of probabilistic interpretations of quantum mechanics by F{\textbackslash}'enyes, Nelson and others as well as the notion of "Euclidean Quantum Mechanics" as probabilistic analogue of quantization. In the second part of the paper Schr{\textbackslash}"odinger discusses the relation between time reversal and statistical laws of physics. We emphasize in our commentary the relevance of Schr{\textbackslash}"odinger's intuitions for contemporary developments in statistical nano-physics.},
