@misc{hironoUnderstandingDiffusionModels2024,
  title = {Understanding {{Diffusion Models}} by {{Feynman}}'s {{Path Integral}}},
  author = {Hirono, Yuji and Tanaka, Akinori and Fukushima, Kenji},
  year = {2024},
