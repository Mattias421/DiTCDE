@misc{chenAnalogBitsGenerating2023,
  title = {Analog {{Bits}}: {{Generating Discrete Data}} Using {{Diffusion Models}} with {{Self-Conditioning}}},
  shorttitle = {Analog {{Bits}}},
  author = {Chen, Ting and Zhang, Ruixiang and Hinton, Geoffrey},
  year = {2023},
